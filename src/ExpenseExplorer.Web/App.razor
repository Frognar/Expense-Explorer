@implements IDisposable
@inject Language Language
@inject Appearance Appearance

<MudThemeProvider Theme="Themes.App" IsDarkMode="Appearance.IsDark"/>
<MudPopoverProvider/>
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true"/>
<MudSnackbarProvider/>

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <PageTitle>@Language.Text.NotFound</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudText Typo="Typo.h6">@Language.Text.NotFound</MudText>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnInitialized() => Appearance.Changed += OnAppearanceChanged;

    public void Dispose() => Appearance.Changed -= OnAppearanceChanged;

    private void OnAppearanceChanged(object? sender, EventArgs args) => StateHasChanged();
}

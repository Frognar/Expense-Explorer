@using System.Globalization
@* MudBlazor's picker rather than the browser's: the browser shows dates in its own language, not the app's.
   Tapping the field opens the calendar, so no icon takes room from the date. *@
<MudDatePicker Date="@Date" DateChanged="OnChanged" Label="@Label" Culture="CultureInfo.CurrentCulture"
               DateFormat="@CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern" AutoClose="true" Adornment="Adornment.None"
               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="@Clearable" ShrinkLabel="true"
               Error="@(ErrorText is not null)" ErrorText="@ErrorText"/>

@code {
    [Parameter]
    public DateOnly? Value { get; set; }

    [Parameter]
    public EventCallback<DateOnly?> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public bool Clearable { get; set; }

    private DateTime? Date => Value?.ToDateTime(TimeOnly.MinValue);

    private Task OnChanged(DateTime? date) =>
        ValueChanged.InvokeAsync(date is { } value ? DateOnly.FromDateTime(value) : null);
}

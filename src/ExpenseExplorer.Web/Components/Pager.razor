@if (PageCount > 1)
{
    <div class="d-flex justify-center my-3">
        <MudPagination Count="PageCount" Selected="Page" SelectedChanged="PageChanged" Size="Size.Small"
                       BoundaryCount="1" MiddleCount="3" Color="Color.Primary"/>
    </div>
}

@code {
    [Parameter]
    public int Page { get; set; }

    [Parameter]
    public int PageSize { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private int PageCount => PageSize <= 0 ? 0 : (TotalCount + PageSize - 1) / PageSize;
}

@* Same destinations on every screen size: app bar on desktop, bottom bar on phones. *@
@foreach (NavTarget target in Targets)
{
    <NavLink class="@(Horizontal ? "top-link" : "bottom-link")" href="@target.Href" Match="@target.Match">
        <MudIcon Icon="@target.Icon" Size="Size.Small"/>
        <span>@target.Label</span>
    </NavLink>
}

@code {
    [Parameter]
    public bool Horizontal { get; set; }

    private sealed record NavTarget(string Href, string Label, string Icon, NavLinkMatch Match);

    private static readonly NavTarget[] Targets =
    [
        new("", "Paragony", Icons.Material.Filled.ReceiptLong, NavLinkMatch.All),
        new("receipt-items", "Pozycje", Icons.Material.Filled.ShoppingBasket, NavLinkMatch.Prefix),
        new("reports", "Raporty", Icons.Material.Filled.PieChart, NavLinkMatch.Prefix),
    ];
}

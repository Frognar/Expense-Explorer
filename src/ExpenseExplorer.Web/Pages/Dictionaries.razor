@page "/dictionaries"
@implements IDisposable
@inject ExpenseApi Api
@inject AuthSession Auth
@inject Language Language
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@Language.Text.Dictionaries · Expense Explorer</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-2">@Language.Text.Dictionaries</MudText>

<MudPaper Elevation="1" Class="pa-3 mb-3">
    <MudStack Spacing="2">
        <MudToggleGroup T="Suggestions" Value="_kind" ValueChanged="kind => Show(kind, null)" Color="Color.Primary" Size="Size.Small">
            <MudToggleItem Value="Suggestions.Items" Text="@Language.Text.ItemNames"/>
            <MudToggleItem Value="Suggestions.Categories" Text="@Language.Text.Categories"/>
            <MudToggleItem Value="Suggestions.Stores" Text="@Language.Text.Stores"/>
        </MudToggleGroup>
        <MudTextField T="string" Label="@Language.Text.Search" Value="@_search" ValueChanged="search => Show(_kind, search)"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"/>
    </MudStack>
</MudPaper>

@if (_problem is not null)
{
    <ProblemAlert Problem="_problem"/>
}
else if (_names is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
}
else if (_names.Count == 0)
{
    <MudText Class="pa-4" Align="Align.Center">@Language.Text.NothingFound</MudText>
}
else
{
    <MudPaper Elevation="1">
        @foreach (NameUsageResponse name in _names)
        {
            <div class="d-flex align-center gap-2 px-3 py-1 list-row">
                <MudLink Href="@ItemsWith(name.Name)" Class="flex-grow-1 text-truncate" Color="Color.Inherit">
                    <div class="text-truncate">@name.Name</div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.Text.UsedTimes(name.Uses, Display.Date(name.LastUsed))</MudText>
                </MudLink>
                @if (Auth.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@Language.Text.Rename"
                                   OnClick="() => RenameAsync(name.Name)"/>
                }
            </div>
            <MudDivider/>
        }
    </MudPaper>
    @if (_names.Count == Limit)
    {
        <MudText Typo="Typo.caption" Class="d-block pa-2 mud-text-secondary">@Language.Text.ShowingFirst(Limit)</MudText>
    }
}

@code {
    private const int Limit = 200;

    private Suggestions _kind = Suggestions.Items;
    private string? _search;
    private IReadOnlyList<NameUsageResponse>? _names;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (Navigation.IsOn(Routes.Dictionaries()))
        {
            _ = InvokeAsync(LoadAsync);
        }
    }

    private async Task LoadAsync()
    {
        QueryReader query = QueryReader.Of(new Uri(Navigation.Uri));
        _kind = query.Text("kind") switch
        {
            "stores" => Suggestions.Stores,
            "categories" => Suggestions.Categories,
            _ => Suggestions.Items,
        };
        _search = query.Text("search");
        ApiResult<IReadOnlyList<NameUsageResponse>> result = await Api.NameUsageAsync(_kind, _search, Limit);
        _names = result.ValueOrDefault;
        _problem = result.Problem;
        StateHasChanged();
    }

    private void Show(Suggestions kind, string? search) => Navigation.NavigateTo(Routes.Dictionaries(kind, search));

    private string ItemsWith(string name) => _kind switch
    {
        Suggestions.Stores => Routes.Receipts(new ReceiptListRequest { Stores = [name] }),
        Suggestions.Items => Routes.ReceiptItems(new ReceiptItemListRequest { Items = [name] }),
        _ => Routes.ReceiptItems(new ReceiptItemListRequest { Categories = [name] }),
    };

    private async Task RenameAsync(string name)
    {
        IDialogReference dialog = await Dialogs.ShowAsync<RenameDialog>(
            Language.Text.Rename,
            new DialogParameters<RenameDialog> { { d => d.Kind, _kind }, { d => d.From, name } });
        if (await dialog.Result is { Canceled: false, Data: RenameNameResponse renamed })
        {
            Snackbar.Add(
                renamed.Merged ? Language.Text.MergedInto(renamed.Name) : Language.Text.ChangedCount(renamed.Changed),
                Severity.Success);
            await LoadAsync();
        }
    }
}

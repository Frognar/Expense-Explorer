@page "/reports"
@inject AuthSession Auth
@inject Language Language
@inject NavigationManager Navigation

<PageTitle>@Language.Text.Reports · Expense Explorer</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-2">@Language.Text.Reports</MudText>

@* The chosen tab is kept in the address, so the back button returns to it. *@
<MudTabs ActivePanelIndex="@Views.IndexOf(View)" ActivePanelIndexChanged="Show" Rounded="true" TabPanelsClass="pt-3" MinimumTabWidth="0px"
         ApplyEffectsToContainer="true" Class="report-tabs">
    @* Each tab takes an equal share of the width, so all of them fit on a phone. *@
    <MudTabPanel Text="@Language.Text.Categories">
        <CategoryReport/>
    </MudTabPanel>
    <MudTabPanel Text="@Language.Text.ByMonth">
        <MonthlyReport/>
    </MudTabPanel>
    @if (Auth.CanEdit)
    {
        <MudTabPanel Text="@Language.Text.Budget">
            <BudgetHistory/>
        </MudTabPanel>
    }
</MudTabs>

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? RequestedView { get; set; }

    // The budget is for editors only, so its tab is the last one and simply missing for readers.
    private List<ReportView> Views => Auth.CanEdit ? [ReportView.Categories, ReportView.Months, ReportView.Budget]
        : [ReportView.Categories, ReportView.Months];

    private ReportView View =>
        Enum.TryParse(RequestedView, ignoreCase: true, out ReportView view) && Views.Contains(view) ? view : ReportView.Categories;

    private void Show(int index) => Navigation.NavigateTo(Routes.ReportsView(Views[index]), replace: true);
}

@inject ExpenseApi Api
@inject Language Language
@inject IDialogService Dialogs

@* A planned expense of a period. *@
<MudDialog>
    <DialogContent>
        <EditForm Model="this" OnSubmit="SaveAsync" id="plan-item-form">
            <MudStack Spacing="2">
                <MudTextField T="string" @bind-Value="_name" Label="@Language.Text.Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                              MaxLength="100" AutoFocus="@(Item is null)" Error="@(ErrorFor("name") is not null)" ErrorText="@ErrorFor("name")"/>
                <MudSelect T="Guid?" @bind-Value="_groupId" Label="@Language.Text.Group" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Error="@(ErrorFor("groupId") is not null)" ErrorText="@ErrorFor("groupId")"
                           ToStringFunc="@(id => Groups.FirstOrDefault(group => group.Id == id)?.Name ?? "")">
                    @foreach (GroupBudgetResponse group in Groups)
                    {
                        <MudSelectItem T="Guid?" Value="group.Id">@group.Name</MudSelectItem>
                    }
                </MudSelect>
                <DecimalInput @bind-Value="_amount" Label="@Language.Text.Amount" ErrorText="@ErrorFor("amount")"/>
                <ProblemAlert Problem="_problem" Fields="Fields"/>
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        @if (Item is not null)
        {
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="_busy" Class="mr-auto">@Language.Text.Delete</MudButton>
        }
        <MudButton OnClick="() => Dialog.Cancel()">@Language.Text.Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="plan-item-form" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="_busy">@Language.Text.Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly string[] Fields = ["name", "groupId", "amount"];

    private string? _name;
    private Guid? _groupId;
    private decimal? _amount;
    private ApiProblem? _problem;
    private bool _busy;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid PeriodId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<GroupBudgetResponse> Groups { get; set; } = [];

    /// <summary>The expense to change; a new one is added when this is null.</summary>
    [Parameter]
    public PlanItemResponse? Item { get; set; }

    /// <summary>Starting group for a new expense, e.g. the one it was added from.</summary>
    [Parameter]
    public Guid? GroupId { get; set; }

    protected override void OnInitialized()
    {
        _name = Item?.Name;
        _groupId = Item?.GroupId ?? GroupId;
        _amount = Item?.Amount;
    }

    private string? ErrorFor(string field) =>
        _problem?.CodesFor(field) is { Count: > 0 } codes ? Language.Errors(codes) : null;

    private async Task SaveAsync()
    {
        _busy = true;
        ApiResult<bool> result = await Api.SavePlanItemAsync(PeriodId, Item?.Id, new PlanItemRequest(_groupId, _name, _amount));
        _busy = false;
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task DeleteAsync()
    {
        if (Item is null || !await Confirm.AskAsync(Dialogs, Language.Text, Language.Text.DeleteQuestion))
        {
            return;
        }

        _busy = true;
        ApiResult<bool> result = await Api.RemovePlanItemAsync(PeriodId, Item.Id);
        _busy = false;
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            Dialog.Close(DialogResult.Ok(true));
        }
    }
}
